# ============================================================================
#  LED_Strip_Controller_G474 - .gitignore  (STM32CubeIDE / CubeMX project)
# ----------------------------------------------------------------------------
#  Keep .cproject, .mxproject, .project and the .ioc tracked - they are needed
#  to recreate the project in CubeIDE and regenerate code from CubeMX. Do NOT
#  add them here.
# ============================================================================

# --- Build output directories ---
/Debug/
/Release/

# --- Per-user IDE workspace settings ---
# Exclude the DIRECTORY CONTENTS, not the directory itself: git cannot
# re-include a file whose parent directory is excluded, so "/.settings/" would
# make the exceptions below impossible. Those two ARE project settings, not
# per-user ones - text encoding and line delimiter decide how the tree renders
# and how new files are written, so they belong to the project.
/.settings/*
!/.settings/org.eclipse.core.resources.prefs
!/.settings/org.eclipse.core.runtime.prefs
*.metadata

# CubeMX backup files (common when regenerating)
*.bak

# OS / editor junk (safe to ignore everywhere)
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
*.tmp
*.log

# --- Merge / rebase leftovers ---
*.orig
*.rej

# --- Other editors ---
.vscode/
.idea/

# --- Claude Code per-user local settings (project skills ARE tracked) ---
.claude/settings.local.json

# Python bytecode caches
__pycache__/
*.py[cod]

# Crossnote / Markdown Preview Enhanced (editor-local preview styling)
.crossnote/

# External reference / example code from other projects (not part of this tree)
/Docs/Not-in-project-temp/

# Per-machine bench overrides (see scripts/bench.defaults.json)
scripts/bench.defaults.local.json

# Last /playstr body for play_bench.py replay (machine-local)
scripts/.play_bench_last

# Host FS shell sandbox + local smoke artifacts (not in-repo content)
/test-sandbox/
scripts/fs_shell_smoke_out.txt
scripts/fs_shell_smoke_err.txt
scripts/fs_shell_smoke_roundtrip.txt
scripts/berrytest*.txt
